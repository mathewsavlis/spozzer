---
import { contactData } from "../data/contactData.js";
---

<section
  id="contato"
  class="contact"
  data-contact
  aria-labelledby="contact-title"
>
  <div class="contact__container">
    <header class="contact__header">
      <p class="contact__eyebrow type-eyebrow">
        {contactData.eyebrow}
      </p>

      <h2 id="contact-title" class="contact__title type-display">
        {contactData.title}
      </h2>

      <p class="contact__description type-body">
        {contactData.description}
      </p>
    </header>

    <form class="contact-form" data-contact-form novalidate>
      <!--
        Honeypot.

        Continua existindo no formulário para bots,
        mas não usamos mais left:-10000px porque
        isso pode contribuir para overflow horizontal.
      -->

      <div class="contact-form__honeypot" aria-hidden="true">
        <label>
          Website

          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="contact-form__field">
        <label class="contact-form__label" for="contact-name"> Nome </label>

        <input
          id="contact-name"
          class="contact-form__input"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="80"
          required
        />

        <span
          class="contact-form__error"
          data-error-for="name"
          aria-live="polite"></span>
      </div>

      <div class="contact-form__field">
        <label class="contact-form__label" for="contact-email"> E-mail </label>

        <input
          id="contact-email"
          class="contact-form__input"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="160"
          required
        />

        <span
          class="contact-form__error"
          data-error-for="email"
          aria-live="polite"></span>
      </div>

      <div class="contact-form__field">
        <label class="contact-form__label" for="contact-phone">
          WhatsApp
        </label>

        <input
          id="contact-phone"
          class="contact-form__input"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          maxlength="24"
          required
        />

        <span
          class="contact-form__error"
          data-error-for="phone"
          aria-live="polite"></span>
      </div>

      <div class="contact-form__field
          contact-form__field--message">
        <label class="contact-form__label" for="contact-message">
          Conte sobre o projeto
        </label>

        <textarea
          id="contact-message"
          class="contact-form__input
            contact-form__textarea"
          name="message"
          rows="3"
          maxlength="2000"
          required></textarea>

        <span
          class="contact-form__error"
          data-error-for="message"
          aria-live="polite"></span>
      </div>

      <div class="contact-form__footer">
        <p
          class="contact-form__status"
          data-form-status
          role="status"
          aria-live="polite"
        >
        </p>

        <button class="contact-form__submit" type="submit" data-contact-submit>
          <span data-submit-label>
            {contactData.submitLabel}
          </span>

          <span class="contact-form__arrow" aria-hidden="true"> → </span>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  /* =========================================
     SECTION
     ========================================= */

  .contact {
    position: relative;

    display: flex;

    width: 100%;
    max-width: 100%;

    min-height: var(--contact-stable-height, 100svh);

    align-items: center;

    padding: clamp(2.25rem, 6svh, 3.5rem) var(--page-inline)
      calc(clamp(1.75rem, 4svh, 2.75rem) + var(--safe-bottom));

    overflow: hidden;

    background: linear-gradient(
      to bottom,
      #eae6df 0%,
      var(--color-light) 16%,
      var(--color-light) 100%
    );

    color: var(--color-dark);
  }

  .contact__container {
    display: grid;

    width: 100%;
    max-width: var(--content-max);

    min-width: 0;

    margin-inline: auto;

    gap: clamp(1.4rem, 4svh, 2.25rem);
  }

  /* =========================================
     HEADER
     ========================================= */

  .contact__header {
    min-width: 0;

    max-width: 35rem;
  }

  .contact__eyebrow {
    margin-bottom: 1.1rem;

    color: var(--color-gold);

    letter-spacing: 0.32em;
  }

  .contact__title {
    max-width: 11ch;

    font-size: clamp(3rem, 11vw, 4.25rem);

    line-height: 0.9;

    text-wrap: balance;
  }

  .contact__description {
    width: calc(100% - var(--copy-gutter));

    max-width: 25rem;

    margin-top: 2rem;

    color: rgba(42, 42, 42, 0.66);

    font-size: clamp(0.72rem, 2.7vw, 0.82rem);

    line-height: 1.85;

    text-wrap: pretty;
  }

  /* =========================================
     FORM
     ========================================= */

  .contact-form {
    position: relative;

    display: grid;

    width: 100%;
    min-width: 0;

    gap: clamp(0.75rem, 2.2svh, 1.1rem);
  }

  .contact-form__field {
    position: relative;

    display: grid;

    width: 100%;
    min-width: 0;

    gap: 0.32rem;
  }

  .contact-form__label {
    color: rgba(42, 42, 42, 0.58);

    font-family: var(--font-sans);

    font-size: 0.54rem;

    font-weight: 500;

    letter-spacing: 0.18em;

    text-transform: uppercase;
  }

  /*
   * IMPORTANTE — iOS
   *
   * Campos menores que aproximadamente
   * 16px podem provocar autozoom do Safari
   * quando recebem foco.
   *
   * 1rem = 16px com o root padrão.
   */

  .contact-form__input {
    display: block;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    padding: 0 0 0.52rem;

    border: 0;

    border-bottom: 1px solid rgba(42, 42, 42, 0.24);

    border-radius: 0;

    outline: 0;

    background: transparent;

    color: var(--color-dark);

    font-family: var(--font-sans);

    /*
     * Não reduzir abaixo de 16px
     * no mobile.
     */
    font-size: 1rem;

    font-weight: 400;

    line-height: 1.25;

    transition: border-color var(--duration-normal) var(--ease-premium);
  }

  .contact-form__input:focus {
    border-color: var(--color-gold);
  }

  .contact-form__input[aria-invalid="true"] {
    border-color: rgba(210, 90, 90, 0.85);
  }

  .contact-form__textarea {
    min-height: 3.25rem;

    max-height: 5rem;

    resize: vertical;
  }

  .contact-form__error {
    min-height: 1em;

    color: rgba(225, 125, 125, 0.9);

    font-family: var(--font-sans);

    font-size: 0.62rem;

    line-height: 1.4;
  }

  /* =========================================
     SUBMIT
     ========================================= */

  .contact-form__footer {
    display: grid;

    min-width: 0;

    gap: 0.65rem;

    margin-top: 0.15rem;
  }

  .contact-form__status {
    min-height: 1em;

    color: rgba(42, 42, 42, 0.64);

    font-family: var(--font-sans);

    font-size: 0.66rem;

    line-height: 1.35;
  }

  .contact-form__submit {
    display: inline-flex;

    width: fit-content;

    max-width: 100%;

    align-items: center;

    gap: 0.85rem;

    padding: 0.65rem 0;

    border-bottom: 1px solid var(--color-gold);

    color: var(--color-dark);

    font-family: var(--font-sans);

    font-size: 0.61rem;

    font-weight: 500;

    letter-spacing: 0.2em;

    cursor: pointer;

    text-transform: uppercase;
  }

  .contact-form__submit:disabled {
    opacity: 0.4;

    cursor: wait;
  }

  .contact-form__arrow {
    font-size: 1rem;

    transition: transform var(--duration-normal) var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-form__submit:hover:not(:disabled) .contact-form__arrow {
      transform: translateX(5px);
    }
  }

  /* =========================================
     HONEYPOT
     =========================================
     Não usar left:-10000px.
     ========================================= */

  .contact-form__honeypot {
    position: absolute;

    width: 1px;

    height: 1px;

    padding: 0;

    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);

    clip-path: inset(50%);

    white-space: nowrap;

    border: 0;

    pointer-events: none;
  }

  /* =========================================
     DESKTOP
     ========================================= */

  @media (min-width: 48rem) {
    .contact {
      min-height: 100dvh;

      padding: clamp(3.5rem, 7dvh, 5.5rem) var(--page-inline);
    }

    .contact__container {
      grid-template-columns:
        minmax(0, 0.85fr)
        minmax(0, 1.15fr);

      align-items: center;

      gap: clamp(4rem, 8vw, 8rem);
    }

    .contact__header {
      max-width: 38rem;
    }

    .contact__title {
      font-size: clamp(4.4rem, 5vw, 5.8rem);
      line-height: 0.88;
    }

    .contact__description {
      max-width: 29rem;

      margin-top: 2.25rem;

      font-size: clamp(0.8rem, 0.9vw, 0.92rem);
    }

    .contact-form {
      gap: clamp(1rem, 2dvh, 1.4rem);
    }

    /*
     * Preserva o tamanho desktop anterior.
     */
    .contact-form__input {
      font-size: clamp(0.92rem, 3.3vw, 1.08rem);
    }

    .contact-form__textarea {
      min-height: 3.5rem;
    }
  }
</style>
